namespace LPS.APS.Engine.Services.Sync;

/// <summary>
/// 夜间批次编排器接口（2号位职责）
/// 编排凌晨数据管道：全量订单同步 → 创建计划版本 → 订单装载到分区表
/// 调用时机：每日凌晨 00:30 由 Hangfire 触发
/// </summary>
public interface INightlyBatchOrchestrator
{
    /// <summary>
    /// 执行夜间批次管道
    /// 步骤：
    /// 1. 全量订单同步（ERP → Staging → Order_Canonical）
    /// 2. 创建新的计划版本（PlanVersion）
    /// 3. 订单装载到分区表（Order_Canonical → Order）
    /// 
    /// BOM 展开由 5 号位负责，不在此编排
    /// </summary>
    Task RunAsync(CancellationToken cancellationToken = default);
}
