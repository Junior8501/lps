using System.IO.Compression;
using System.Security.Cryptography;
using System.Text;
using System.Text.Json;
using System.Text.Json.Serialization;
using LPS.APS.Application.Services.Dto;
using LPS.APS.Core.Models.Scheduling;
using LPS.APS.Engine.Data;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Logging;

namespace LPS.APS.Application.Services;

/// <summary>
/// 排程快照封存服务（2号位职责 — §2.6 历史追溯的终极解法）
/// 
/// 将排程完成后的 SchedulingContext 序列化为高度压缩的 .json.gz 文件，
/// 封存到物理服务器的机械硬盘（4.76T HDD）。
/// 
/// 快照内容包含：
///   ✅ 绝对工艺路线、标准工时、BOM层级对
///   ✅ 库存余额、资源日历、订单优先级
///   ✅ Pegging关系、Task拆批规则
/// 
/// 文件格式：Snapshot_{PlanVersionId}_{VersionCode}_{yyyyMMdd_HHmmss}.json.gz
/// 哈希算法：SHA256（防篡改校验）
/// </summary>
public class SnapshotService : ISnapshotService
{
    private readonly DatabaseConnectionManager _connectionManager;
    private readonly ILogger<SnapshotService> _logger;
    private readonly string _storagePath;

    private static readonly JsonSerializerOptions _serializerOptions = new()
    {
        WriteIndented = false,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        PropertyNamingPolicy = null,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    public SnapshotService(
        DatabaseConnectionManager connectionManager,
        IConfiguration configuration,
        ILogger<SnapshotService> logger)
    {
        _connectionManager = connectionManager ?? throw new ArgumentNullException(nameof(connectionManager));
        _logger = logger ?? throw new ArgumentNullException(nameof(logger));

        _storagePath = configuration["Snapshot:StoragePath"] ?? @"D:\APS_Snapshots";
    }

    /// <inheritdoc />
    public async Task<SnapshotInfo> SaveAsync(
        SchedulingContext context,
        int planVersionId,
        CancellationToken cancellationToken = default)
    {
        _logger.LogInformation("快照封存开始: PlanVersionId={PlanVersionId}", planVersionId);
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();

        // 1. 确保存储目录存在
        Directory.CreateDirectory(_storagePath);

        // 2. 生成文件名
        var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
        var versionCode = context.PlanVersionId;
        var fileName = $"Snapshot_{planVersionId}_{versionCode}_{timestamp}.json.gz";
        var filePath = Path.Combine(_storagePath, fileName);

        // 3. 序列化为JSON字符串（用于计算原始大小）
        var json = JsonSerializer.Serialize(context, _serializerOptions);
        var originalSize = Encoding.UTF8.GetByteCount(json);

        // 4. 写入 .json.gz 文件（流式压缩）
        await using (var fileStream = new FileStream(filePath, FileMode.Create, FileAccess.Write, FileShare.None, 65536, useAsync: true))
        await using (var gzipStream = new GZipStream(fileStream, CompressionLevel.Optimal))
        {
            var jsonBytes = Encoding.UTF8.GetBytes(json);
            await gzipStream.WriteAsync(jsonBytes, cancellationToken);
        }

        var compressedSize = new FileInfo(filePath).Length;

        // 5. 计算 SHA256 哈希
        var fileHash = await CalculateFileHashAsync(filePath, cancellationToken);

        var snapshotTime = DateTime.Now;

        // 6. 更新 PlanVersion 快照元数据
        await _connectionManager.ExecuteAsync(
            @"UPDATE PlanVersion 
              SET SnapshotFilePath = @FilePath,
                  SnapshotFileSize = @OriginalSize,
                  SnapshotCompressedSize = @CompressedSize,
                  SnapshotFileHash = @FileHash,
                  SnapshotCreatedAt = @CreatedAt
              WHERE Id = @Id",
            new
            {
                Id = planVersionId,
                FilePath = filePath,
                OriginalSize = originalSize,
                CompressedSize = compressedSize,
                FileHash = fileHash,
                CreatedAt = snapshotTime
            },
            db: DatabaseId.APS);

        stopwatch.Stop();

        var compressionRatio = originalSize > 0 ? (double)compressedSize / originalSize * 100 : 0;
        _logger.LogInformation(
            "快照封存完成: PlanVersionId={PlanVersionId}, 文件={FileName}, 原始={OriginalMB:F1}MB, 压缩={CompressedMB:F1}MB, 压缩率={Ratio:F1}%, 耗时={Elapsed}ms",
            planVersionId, fileName,
            originalSize / 1048576.0, compressedSize / 1048576.0,
            compressionRatio, stopwatch.ElapsedMilliseconds);

        return new SnapshotInfo
        {
            FilePath = filePath,
            OriginalSize = originalSize,
            CompressedSize = compressedSize,
            FileHash = fileHash,
            CreatedAt = snapshotTime
        };
    }

    /// <inheritdoc />
    public async Task<SchedulingContext> LoadAsync(int planVersionId, CancellationToken cancellationToken = default)
    {
        _logger.LogInformation("快照读取开始: PlanVersionId={PlanVersionId}", planVersionId);

        // 1. 从 PlanVersion 表获取快照信息
        var snapshotMeta = await _connectionManager.QueryFirstOrDefaultAsync<SnapshotMetaDto>(
            @"SELECT SnapshotFilePath, SnapshotFileSize, SnapshotFileHash, SnapshotCompressedSize, SnapshotCreatedAt
              FROM PlanVersion
              WHERE Id = @Id",
            new { Id = planVersionId },
            db: DatabaseId.APS);

        if (snapshotMeta == null || string.IsNullOrWhiteSpace(snapshotMeta.SnapshotFilePath))
            throw new InvalidOperationException($"计划版本 {planVersionId} 无快照记录");

        if (!File.Exists(snapshotMeta.SnapshotFilePath))
            throw new FileNotFoundException($"快照文件不存在: {snapshotMeta.SnapshotFilePath}");

        // 2. 校验 SHA256 哈希
        var actualHash = await CalculateFileHashAsync(snapshotMeta.SnapshotFilePath, cancellationToken);
        if (!string.Equals(actualHash, snapshotMeta.SnapshotFileHash, StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidDataException(
                $"快照文件已损坏或被篡改: PlanVersionId={planVersionId}, " +
                $"预期={snapshotMeta.SnapshotFileHash}, 实际={actualHash}");
        }

        // 3. 解压并反序列化
        await using var fileStream = new FileStream(
            snapshotMeta.SnapshotFilePath, FileMode.Open, FileAccess.Read, FileShare.Read, 65536, useAsync: true);
        await using var gzipStream = new GZipStream(fileStream, CompressionMode.Decompress);

        var context = await JsonSerializer.DeserializeAsync<SchedulingContext>(
            gzipStream, _serializerOptions, cancellationToken);

        if (context == null)
            throw new InvalidDataException($"快照反序列化失败: PlanVersionId={planVersionId}");

        _logger.LogInformation(
            "快照读取完成: PlanVersionId={PlanVersionId}, Tasks={TaskCount}, Resources={ResourceCount}",
            planVersionId, context.Tasks.Count, context.Resources.Count);

        return context;
    }

    /// <inheritdoc />
    public async Task<bool> VerifyAsync(int planVersionId)
    {
        try
        {
            var snapshotMeta = await _connectionManager.QueryFirstOrDefaultAsync<SnapshotMetaDto>(
                @"SELECT SnapshotFilePath, SnapshotFileHash
                  FROM PlanVersion
                  WHERE Id = @Id",
                new { Id = planVersionId },
                db: DatabaseId.APS);

            if (snapshotMeta == null || string.IsNullOrWhiteSpace(snapshotMeta.SnapshotFilePath))
                return false;

            if (!File.Exists(snapshotMeta.SnapshotFilePath))
                return false;

            var actualHash = await CalculateFileHashAsync(snapshotMeta.SnapshotFilePath);
            return string.Equals(actualHash, snapshotMeta.SnapshotFileHash, StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "快照校验异常: PlanVersionId={PlanVersionId}", planVersionId);
            return false;
        }
    }

    /// <summary>
    /// 计算文件 SHA256 哈希值
    /// </summary>
    private static async Task<string> CalculateFileHashAsync(string filePath, CancellationToken cancellationToken = default)
    {
        using var sha256 = SHA256.Create();
        await using var stream = new FileStream(filePath, FileMode.Open, FileAccess.Read, FileShare.Read, 65536, useAsync: true);
        var hashBytes = await sha256.ComputeHashAsync(stream, cancellationToken);
        return Convert.ToHexString(hashBytes).ToLowerInvariant();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 内部 DTO（仅本类 Dapper 投影使用，不对外暴露）
    // ═══════════════════════════════════════════════════════════════════════════

    /// <summary>
    /// PlanVersion 快照元数据查询映射
    /// </summary>
    private class SnapshotMetaDto
    {
        public string? SnapshotFilePath { get; set; }
        public long? SnapshotFileSize { get; set; }
        public string? SnapshotFileHash { get; set; }
        public long? SnapshotCompressedSize { get; set; }
        public DateTime? SnapshotCreatedAt { get; set; }
    }
}
